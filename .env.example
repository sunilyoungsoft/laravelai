APP_NAME="Laravel AI ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Application timezone is UTC. Laravel is the source of truth for system timestamps.
# Do not rely on MySQL NOW() or CURRENT_TIMESTAMP for application timestamp fields.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password hashing. Application-wide Argon2id (Platform + Workspace users) via Laravel's
# Hash abstraction. Argon params are tunable per environment; bcrypt rounds retained so
# legacy bcrypt hashes still verify and rehash to Argon2id on next login.
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel default connection. Platform schema uses the named `platform` connection.
DB_CONNECTION=platform
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravelai_platform
DB_USERNAME=root
DB_PASSWORD=

# Platform database (semantic connection: platform)
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=laravelai_platform
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=

# Workspace database connection template (host/user/password reused for tenant connections).
# Phase 1D provisioning creates one physical database per company (workspace_{ulid}).
WORKSPACE_DB_HOST=127.0.0.1
WORKSPACE_DB_PORT=3306
WORKSPACE_DB_DATABASE=laravelai_workspace_example
WORKSPACE_DB_USERNAME=root
WORKSPACE_DB_PASSWORD=

# Phase 1D: platform-managed base domain for tenant subdomains ({label}.{base}).
# Not finalized — leave blank until a real base domain is chosen. Subdomain creation
# fails safely while this is unset.
PLATFORM_BASE_DOMAIN=

# Phase 1B: temporary default until Workspace auth exists. Use Auth::guard('platform') explicitly.
AUTH_GUARD=platform

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
