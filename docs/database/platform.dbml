// Platform database schema — Phase 1C
// Update this file whenever platform_db schema changes.
// Do not document workspace databases here.
//
// Soft-delete identity policy:
// - platform_users.email and platform_users.phone remain reserved after soft delete.
// - platform_roles.slug and platform_permissions.slug remain reserved after soft delete.
// - companies.slug and companies.database_name remain reserved after soft delete.
// Restore the existing record instead of creating a duplicate identity.
//
// Company identities:
// - id (ULID) and database_name are stable internal identities.
// - database_name format: workspace_{lowercase_ulid} (metadata only in Phase 1C; no physical DB yet).
// - slug is the public/platform identifier; future rename policy is not decided.

Table platform_users {
  id ulid [pk]
  name varchar
  email varchar [unique, not null]
  phone varchar [unique, not null]
  password varchar [not null]
  email_verified_at timestamp [null]
  status tinyint [default: 1, note: '1=active, 0=inactive']
  failed_login_attempts smallint [default: 0]
  is_locked boolean [default: false]
  locked_until timestamp [null]
  last_failed_login timestamp [null]
  last_login_at timestamp [null]
  two_factor_enabled boolean [default: false]
  two_factor_secret text [null, note: 'Laravel encrypted cast']
  two_factor_confirmed_at timestamp [null]
  created_by ulid [null]
  updated_by ulid [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]

  Note: 'Platform authentication users. Soft deletes enabled. FK deletes: NO ACTION.'
}

Table platform_roles {
  id ulid [pk]
  name varchar
  slug varchar [unique, not null]
  description text [null]
  is_system boolean [default: false]
  status tinyint [default: 1]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]

  Note: 'Protected Admin system role: slug=admin, is_system=true. No wildcard permissions. Soft deletes enabled.'
}

Table platform_permissions {
  id ulid [pk]
  name varchar
  slug varchar [unique, not null]
  description text [null]
  status tinyint [default: 1]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]

  Note: 'Permission catalog is introduced with Platform features. Soft deletes enabled.'
}

Table platform_user_roles {
  user_id ulid [not null]
  role_id ulid [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, role_id) [unique]
  }

  Note: 'Many-to-many: PlatformUser ↔ PlatformRole. FK deletes: NO ACTION.'
}

Table platform_role_permissions {
  role_id ulid [not null]
  permission_id ulid [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (role_id, permission_id) [unique]
  }

  Note: 'Many-to-many: PlatformRole ↔ PlatformPermission. FK deletes: NO ACTION.'
}

Table companies {
  id ulid [pk]
  name varchar
  slug varchar(63) [unique, not null]
  database_name varchar(64) [unique, not null, note: 'workspace_{lowercase_ulid}; no physical DB in Phase 1C']
  contact_person varchar [null]
  email varchar [null]
  secondary_email varchar [null]
  phone varchar [null]
  gst_number varchar [null, note: 'nullable; NOT unique']
  address_line_1 varchar [null]
  address_line_2 varchar [null]
  city varchar [null]
  state varchar [null]
  country_code char(2) [null]
  postal_code varchar [null]
  status varchar [default: 'pending', note: 'CompanyStatus string enum; indexed']
  created_by ulid [not null]
  updated_by ulid [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]

  indexes {
    status [name: 'companies_status_index']
  }

  Note: 'Platform SaaS customer/workspace registry. Soft deletes enabled. FK deletes: NO ACTION. No Workspace DB provisioning in Phase 1C.'
}

Table domains {
  id ulid [pk]
  company_id ulid [not null]
  domain varchar(253) [unique, not null, note: 'Normalized hostname (lowercased, trimmed, no trailing dot). Unique incl. soft-deleted (identity reserved).']
  type varchar [not null, note: 'DomainType string enum: subdomain | custom']
  is_primary boolean [default: false, note: 'At most one primary per company (enforced server-side in SetPrimaryDomainAction).']
  status varchar [default: 'pending', note: 'DomainStatus string enum: pending | active | inactive | verification_failed; indexed']
  verified_at timestamp [null, note: 'Separate from status; not a status value']
  created_by ulid [not null]
  updated_by ulid [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp [null]

  indexes {
    domain [name: 'domains_domain_unique']
    company_id [name: 'domains_company_id_index']
    status [name: 'domains_status_index']
  }

  Note: 'Application-owned hostname → Company map (Phase 1D). NOT Stancl stock domains table. Soft deletes; FK deletes: NO ACTION. Resolution reads this on the platform connection before tenancy init.'
}

Ref: platform_users.created_by > platform_users.id [delete: no action]
Ref: platform_users.updated_by > platform_users.id [delete: no action]
Ref: platform_user_roles.user_id > platform_users.id [delete: no action]
Ref: platform_user_roles.role_id > platform_roles.id [delete: no action]
Ref: platform_role_permissions.role_id > platform_roles.id [delete: no action]
Ref: platform_role_permissions.permission_id > platform_permissions.id [delete: no action]
Ref: companies.created_by > platform_users.id [delete: no action]
Ref: companies.updated_by > platform_users.id [delete: no action]
Ref: domains.company_id > companies.id [delete: no action]
Ref: domains.created_by > platform_users.id [delete: no action]
Ref: domains.updated_by > platform_users.id [delete: no action]
